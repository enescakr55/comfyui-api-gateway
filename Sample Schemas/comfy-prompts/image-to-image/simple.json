{
    "client_id": "{client-id}",
    "prompt": {
        "1": {
            "inputs": {
                "ckpt_name": "512-inpainting-ema.safetensors"
            },
            "class_type": "CheckpointLoaderSimple",
            "_meta": {
                "title": "Load Checkpoint"
            }
        },
        "2": {
            "inputs": {
                "image": "{original-image}"
            },
            "class_type": "LoadImage",
            "_meta": {
                "title": "Load Image"
            }
        },
        "4": {
            "inputs": {
                "text": "{positive-prompt}",
                "clip": [
                    "1",
                    1
                ]
            },
            "class_type": "CLIPTextEncode",
            "_meta": {
                "title": "CLIP Text Encode (Prompt)"
            }
        },
        "5": {
            "inputs": {
                "text": "{negative-prompt}",
                "clip": [
                    "1",
                    1
                ]
            },
            "class_type": "CLIPTextEncode",
            "_meta": {
                "title": "CLIP Text Encode (Prompt)"
            }
        },
        "6": {
            "inputs": {
                "seed": "{seed}",
                "steps": 25,
                "cfg": 7,
                "sampler_name": "uni_pc_bh2",
                "scheduler": "simple",
                "denoise": 1,
                "model": [
                    "1",
                    0
                ],
                "positive": [
                    "4",
                    0
                ],
                "negative": [
                    "5",
                    0
                ],
                "latent_image": [
                    "9",
                    0
                ]
            },
            "class_type": "KSampler",
            "_meta": {
                "title": "KSampler"
            }
        },
        "7": {
            "inputs": {
                "samples": [
                    "6",
                    0
                ],
                "vae": [
                    "1",
                    2
                ],
				"output_alpha": false
            },
            "class_type": "VAEDecode",
            "_meta": {
                "title": "VAE Decode"
            }
        },
        "8": {
            "inputs": {
                "filename_prefix": "aigen_{uuid}",
                "images": [
                    "7",
                    0
                ],
				"file_format": "png"
            },
            "class_type": "SaveImage",
            "_meta": {
                "title": "Save Image"
            }
        },
        "9": {
            "inputs": {
                "grow_mask_by": 2,
                "pixels": [
                    "2",
                    0
                ],
                "vae": [
                    "1",
                    2
                ],
                "mask": [
                    "12",
                    0
                ]
            },
            "class_type": "VAEEncodeForInpaint",
            "_meta": {
                "title": "VAE Encode (for Inpainting)"
            }
        },
        "10": {
            "inputs": {
                "image": "{mask-image}"
            },
            "class_type": "LoadImage",
            "_meta": {
                "title": "Load Image"
            }
        },
        "12": {
            "inputs": {
                "channel": "red",
                "image": [
                    "10",
                    0
                ]
            },
            "class_type": "ImageToMask",
            "_meta": {
                "title": "Convert Image to Mask"
            }
        },
        "13": {
            "inputs": {
                "mask": [
                    "12",
                    0
                ]
            },
            "class_type": "MaskPreview",
            "_meta": {
                "title": "MaskPreview"
            }
        }
    }
}